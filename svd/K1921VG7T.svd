            </fields>
          </register>
        </cluster>
        <!--SPICFG: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>3</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-2</dimIndex>
          <!--end of dimElementGroup-->
          <name>SPICFG[%s]</name>
          <description>SPICFG</description>
          <addressOffset>0x70</addressOffset>
          <register>
            <name />
            <description>SPI Clock and Reset Configuration Register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--DIVN: Divider coefficient-->
              <field>
                <name>DIVN</name>
                <description>Divider coefficient</description>
                <bitRange>[21:16]</bitRange>
                <access>read-write</access>
              </field>
              <!--DIVEN: Enable divider by (2 * (DIVN + 1))-->
              <field>
                <name>DIVEN</name>
                <description>Enable divider by (2 * (DIVN + 1))</description>
                <bitRange>[12:12]</bitRange>
                <access>read-write</access>
              </field>
              <!--CLKSEL: Clock source select-->
              <field>
                <name>CLKSEL</name>
