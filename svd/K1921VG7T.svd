            <!--DIVEN: Enable division by (2 * (DIVN + 1))-->
            <field>
              <name>DIVEN</name>
              <description>Enable division by (2 * (DIVN + 1))</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--CLKSEL: Clock source select-->
            <field>
              <name>CLKSEL</name>
              <description>Clock source select</description>
              <bitRange>[9:8]</bitRange>
              <access>read-only</access>
              <usage>read</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>REFCLK</name>
                  <description>HSI 4MHz if CPE=0 or HSE(XTALL) if CPE=1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SRCCLK</name>
                  <description>HSE(XTALL) if CPE=0 or HSI 4MHz if CPE=1</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSPLL0CLK</name>
