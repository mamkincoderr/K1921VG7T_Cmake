      <addressBlock>
        <offset>0</offset>
        <size>0x118</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>TMR32_0</name>
        <description>32-bit timer 0 interrupt</description>
        <value>3</value>
      </interrupt>
      <interrupt>
        <name>TMR32_0_P</name>
        <description>32-bit timer 0 period interrupt</description>
        <value>115</value>
      </interrupt>
      <interrupt>
        <name>TMR32_0_CC</name>
        <description>32-bit timer 0 capture/compare interrupt</description>
        <value>120</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--CTRL: Timer control register-->
        <register>
          <name>CTRL</name>
          <description>Timer control register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--OUTEN: Output Enable-->
            <field>
              <name>OUTEN</name>
              <description>Output Enable</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <!--CLKSEL: Clock Source Select-->
            <field>
              <name>CLKSEL</name>
              <description>Clock Source Select</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SysClk</name>
                  <description>Select system Clk</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ExtClk</name>
                  <description>Select External Clk</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--DMARXSTOP: Stop Timer when RX DMA channel ends all transactions-->
            <field>
              <name>DMARXSTOP</name>
              <description>Stop Timer when RX DMA channel ends all transactions</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
            </field>
            <!--DMATXSTOP: Stop Timer when TX DMA channel ends all transactions-->
