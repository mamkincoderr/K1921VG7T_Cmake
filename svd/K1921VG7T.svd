              <access>read-write</access>
            </field>
            <!--RXDMAE: Receive DMA enable-->
            <field>
              <name>RXDMAE</name>
              <description>Receive DMA enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--UART1-->
    <peripheral derivedFrom="UART0">
      <name>UART1</name>
      <baseAddress>0x5000F000</baseAddress>
      <interrupt>
        <name>UART1</name>
        <description>UART1 interrupt [any cause]</description>
        <value>47</value>
      </interrupt>
      <interrupt>
        <name>UART1_E</name>
        <description>UART1 Error interrupt</description>
        <value>48</value>
      </interrupt>
      <interrupt>
        <name>UART1_RT</name>
        <description>UART1 Receive Timeout interrupt</description>
        <value>49</value>
      </interrupt>
      <interrupt>
        <name>UART1_RX</name>
        <description>UART1 Receive interrupt</description>
        <value>50</value>
      </interrupt>
      <interrupt>
        <name>UART1_TD</name>
        <description>UART1 Transmit Done interrupt</description>
        <value>51</value>
      </interrupt>
      <interrupt>
        <name>UART1_TX</name>
        <description>UART1 Transmit interrupt</description>
        <value>52</value>
      </interrupt>
    </peripheral>
    <!--SPI0-->
    <peripheral>
      <name>SPI0</name>
      <version>1.0</version>
      <description>SPI control registers</description>
      <groupName>SPI</groupName>
      <baseAddress>0x50010000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x28</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>SPI0</name>
        <description>SPI0 interrupt [any cause]</description>
        <value>26</value>
      </interrupt>
      <interrupt>
        <name>SPI0_RO</name>
        <description>SPI0 Receive Overrun interrupt</description>
        <value>27</value>
      </interrupt>
      <interrupt>
        <name>SPI0_RT</name>
        <description>SPI0 Receive Timeout interrupt</description>
        <value>28</value>
      </interrupt>
      <interrupt>
        <name>SPI0_RX</name>
        <description>SPI0 Receive interrupt</description>
        <value>29</value>
      </interrupt>
      <interrupt>
        <name>SPI0_TX</name>
        <description>SPI0 Transmit interrupt</description>
        <value>30</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--CR: Control register -->
        <register>
          <name>CR</name>
          <description>Control register </description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x44000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TXIFLSEL: Transmit interrupt FIFO level select-->
            <field>
              <name>TXIFLSEL</name>
              <description>Transmit interrupt FIFO level select</description>
