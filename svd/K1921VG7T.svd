          </fields>
        </register>
        <!--DMACR: DMA Control Register-->
        <register>
          <name>DMACR</name>
          <description>DMA Control Register</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
