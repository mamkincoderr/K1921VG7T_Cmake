    <!--CAN-->
    <peripheral>
      <name>CAN</name>
      <version>1.0</version>
      <description>CAN control registers</description>
      <groupName>CAN</groupName>
      <baseAddress>0x40010000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>CAN0</name>
        <description>CAN0 interrupt</description>
        <value>8</value>
      </interrupt>
      <interrupt>
        <name>CAN1</name>
        <description>CAN1 interrupt</description>
        <value>9</value>
      </interrupt>
      <interrupt>
        <name>CAN2</name>
        <description>CAN2 interrupt</description>
        <value>10</value>
      </interrupt>
      <interrupt>
        <name>CAN3</name>
        <description>CAN3 interrupt</description>
        <value>11</value>
      </interrupt>
      <interrupt>
        <name>CAN4</name>
        <description>CAN4 interrupt</description>
        <value>12</value>
      </interrupt>
      <interrupt>
        <name>CAN5</name>
        <description>CAN5 interrupt</description>
        <value>13</value>
      </interrupt>
      <interrupt>
        <name>CAN6</name>
        <description>CAN6 interrupt</description>
        <value>14</value>
      </interrupt>
      <interrupt>
        <name>CAN7</name>
        <description>CAN7 interrupt</description>
        <value>15</value>
      </interrupt>
      <interrupt>
        <name>CAN8</name>
        <description>CAN8 interrupt</description>
        <value>16</value>
      </interrupt>
      <interrupt>
        <name>CAN9</name>
        <description>CAN9 interrupt</description>
        <value>17</value>
      </interrupt>
      <interrupt>
        <name>CAN10</name>
        <description>CAN10 interrupt</description>
        <value>18</value>
      </interrupt>
      <interrupt>
        <name>CAN11</name>
        <description>CAN11 interrupt</description>
        <value>19</value>
      </interrupt>
      <interrupt>
        <name>CAN12</name>
        <description>CAN12 interrupt</description>
        <value>20</value>
      </interrupt>
      <interrupt>
        <name>CAN13</name>
        <description>CAN13 interrupt</description>
        <value>21</value>
      </interrupt>
      <interrupt>
        <name>CAN14</name>
        <description>CAN14 interrupt</description>
        <value>22</value>
      </interrupt>
      <interrupt>
        <name>CAN15</name>
        <description>CAN15 interrupt</description>
        <value>23</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--CLC: Frequency control register-->
        <register>
          <name>CLC</name>
          <description>Frequency control register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x3</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DISS: State CAN-->
            <field>
              <name>DISS</name>
              <description>State CAN</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
            <!--DISR: OFF module CAN-->
            <field>
              <name>DISR</name>
              <description>OFF module CAN</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ID: Identity register-->
        <register>
          <name>ID</name>
          <description>Identity register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x2bc051</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--MODNUM: Identification number CAN-->
            <field>
              <name>MODNUM</name>
              <description>Identification number CAN</description>
              <bitRange>[31:16]</bitRange>
              <access>read-only</access>
            </field>
            <!--MODTYPE: Digit capacity CAN-->
            <field>
              <name>MODTYPE</name>
              <description>Digit capacity CAN</description>
              <bitRange>[15:8]</bitRange>
              <access>read-only</access>
            </field>
            <!--MODREV: Number of modifications of the CAN-->
            <field>
              <name>MODREV</name>
              <description>Number of modifications of the CAN</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FDR: Register divider-->
        <register>
          <name>FDR</name>
          <description>Register divider</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--DISCLK: Disable bit internal clock-->
            <field>
              <name>DISCLK</name>
              <description>Disable bit internal clock</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
            </field>
            <!--ENHW: Control bit synchronization-->
            <field>
              <name>ENHW</name>
              <description>Control bit synchronization</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
            </field>
            <!--RESULT: Count frequency divider-->
            <field>
              <name>RESULT</name>
              <description>Count frequency divider</description>
              <bitRange>[25:16]</bitRange>
              <access>read-only</access>
            </field>
            <!--DM: Mode setting of the frequency divider-->
            <field>
              <name>DM</name>
              <description>Mode setting of the frequency divider</description>
              <bitRange>[15:14]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>counter disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NormalMode</name>
                  <description>normal operation mode</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DividerMode</name>
                  <description>divider operation mode</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--STEP: Step divider-->
            <field>
              <name>STEP</name>
              <description>Step divider</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--LIST: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>8</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-7</dimIndex>
          <!--end of dimElementGroup-->
          <name>LIST[%s]</name>
          <description>LIST</description>
          <addressOffset>0x100</addressOffset>
          <register>
            <name />
            <description>Register list0</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x1000000</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--EMPTY: Indicate empty list-->
              <field>
                <name>EMPTY</name>
                <description>Indicate empty list</description>
                <bitRange>[24:24]</bitRange>
                <access>read-only</access>
              </field>
              <!--SIZE: List size-->
              <field>
                <name>SIZE</name>
                <description>List size</description>
                <bitRange>[23:16]</bitRange>
                <access>read-only</access>
              </field>
              <!--END: Number of the last message object-->
              <field>
                <name>END</name>
                <description>Number of the last message object</description>
                <bitRange>[15:8]</bitRange>
                <access>read-only</access>
              </field>
              <!--BEGIN: Number of the first message object-->
              <field>
                <name>BEGIN</name>
                <description>Number of the first message object</description>
                <bitRange>[7:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--MSPND: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-3</dimIndex>
          <!--end of dimElementGroup-->
          <name>MSPND[%s]</name>
          <description>MSPND</description>
          <addressOffset>0x140</addressOffset>
          <register>
            <name />
            <description>Register waiting interrupts0</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--PND: Field waiting interrupts-->
              <field>
                <name>PND</name>
                <description>Field waiting interrupts</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--MSID: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>4</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-3</dimIndex>
          <!--end of dimElementGroup-->
          <name>MSID[%s]</name>
          <description>MSID</description>
          <addressOffset>0x180</addressOffset>
          <register>
            <name />
            <description>Register messages index0</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-only</access>
            <resetValue>0x20</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--INDEX: -->
              <field>
                <name>INDEX</name>
                <description />
                <bitRange>[5:0]</bitRange>
                <access>read-only</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--MSIMASK: Mask register message index-->
        <register>
          <name>MSIMASK</name>
          <description>Mask register message index</description>
          <addressOffset>0x1c0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--IM: Mask for waiting bit messages-->
            <field>
              <name>IM</name>
              <description>Mask for waiting bit messages</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--PANCTR: Register command panel-->
        <register>
          <name>PANCTR</name>
          <description>Register command panel</description>
          <addressOffset>0x1c4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x301</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--PANAR2: Panel argument 2-->
            <field>
              <name>PANAR2</name>
              <description>Panel argument 2</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <!--PANAR1: Panel argument 1-->
            <field>
              <name>PANAR1</name>
              <description>Panel argument 1</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--RBUSY: Busy flag panels arguments (running the command list, the result of which will be recorded in PANAR1 and PANAR2)-->
            <field>
              <name>RBUSY</name>
              <description>Busy flag panels arguments (running the command list, the result of which will be recorded in PANAR1 and PANAR2)</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
            </field>
            <!--BUSY: Busy flag panels arguments (waiting to be written at the end of the command)-->
            <field>
              <name>BUSY</name>
              <description>Busy flag panels arguments (waiting to be written at the end of the command)</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <!--PANCMD: Command panel-->
            <field>
              <name>PANCMD</name>
              <description>Command panel</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--MCR: Control register-->
        <register>
          <name>MCR</name>
          <description>Control register</description>
          <addressOffset>0x1c8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--MPSEL: Field task position after waiting message bit transmit / receive messages-->
            <field>
              <name>MPSEL</name>
              <description>Field task position after waiting message bit transmit / receive messages</description>
              <bitRange>[15:12]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--MITR: Interrupt register-->
        <register>
          <name>MITR</name>
          <description>Interrupt register</description>
          <addressOffset>0x1cc</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--IT: Field  generate interrupt-->
            <field>
              <name>IT</name>
              <description>Field  generate interrupt</description>
              <bitRange>[15:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--Node: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>2</dim>
          <dimIncrement>256</dimIncrement>
          <dimIndex>0-1</dimIndex>
          <!--end of dimElementGroup-->
          <name>Node[%s]</name>
          <description>Node</description>
          <addressOffset>0x200</addressOffset>
          <register>
            <name>NCR</name>
            <description>Register control node0</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x1</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--CALM: Activate the node analysis-->
              <field>
                <name>CALM</name>
                <description>Activate the node analysis</description>
                <bitRange>[7:7]</bitRange>
                <access>read-write</access>
              </field>
              <!--CCE: Permission node configuration changes-->
              <field>
                <name>CCE</name>
                <description>Permission node configuration changes</description>
                <bitRange>[6:6]</bitRange>
                <access>read-write</access>
              </field>
              <!--CANDIS: Off node-->
              <field>
                <name>CANDIS</name>
                <description>Off node</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <!--ALIE: Enable interrupt ALERT from node-->
              <field>
                <name>ALIE</name>
                <description>Enable interrupt ALERT from node</description>
                <bitRange>[3:3]</bitRange>
                <access>read-write</access>
              </field>
              <!--LECIE: Interrupt enable bit of the assembly when it detects the last error code-->
              <field>
                <name>LECIE</name>
                <description>Interrupt enable bit of the assembly when it detects the last error code</description>
                <bitRange>[2:2]</bitRange>
                <access>read-write</access>
              </field>
              <!--TRIE: Interrupt enable bit of the assembly at the end of the transmission / reception-->
              <field>
                <name>TRIE</name>
                <description>Interrupt enable bit of the assembly at the end of the transmission / reception</description>
                <bitRange>[1:1]</bitRange>
                <access>read-write</access>
              </field>
              <!--INIT: Node initialization-->
              <field>
                <name>INIT</name>
                <description>Node initialization</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
          <register>
            <name>NSR</name>
            <description>Register state node0</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0x0</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--LOE: Error Flag Room list-->
              <field>
                <name>LOE</name>
                <description>Error Flag Room list</description>
                <bitRange>[9:9]</bitRange>
                <access>read-write</access>
              </field>
              <!--LLE: Error flag list-->
              <field>
                <name>LLE</name>
                <description>Error flag list</description>
                <bitRange>[8:8]</bitRange>
                <access>read-write</access>
              </field>
              <!--BOFF: Status flag 'is disconnected from the bus'-->
              <field>
                <name>BOFF</name>
                <description>Status flag 'is disconnected from the bus'</description>
                <bitRange>[7:7]</bitRange>
                <access>read-only</access>
              </field>
              <!--EWRN: Flag critical errors-->
              <field>
                <name>EWRN</name>
                <description>Flag critical errors</description>
                <bitRange>[6:6]</bitRange>
                <access>read-only</access>
              </field>
              <!--ALERT: Warning flag ALERT-->
              <field>
                <name>ALERT</name>
                <description>Warning flag ALERT</description>
                <bitRange>[5:5]</bitRange>
                <access>read-write</access>
              </field>
              <!--RXOK: Flag successful reception of messages-->
              <field>
                <name>RXOK</name>
                <description>Flag successful reception of messages</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <!--TXOK: Flag successful message transmission-->
              <field>
                <name>TXOK</name>
                <description>Flag successful message transmission</description>
