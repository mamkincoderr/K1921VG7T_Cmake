              <name>RTMIS</name>
              <description>Receive timeout masked interrupt status</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
            </field>
            <!--TXMIS: Transmit masked interrupt status-->
            <field>
              <name>TXMIS</name>
              <description>Transmit masked interrupt status</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
            </field>
            <!--RXMIS: Receive masked interrupt status-->
            <field>
              <name>RXMIS</name>
              <description>Receive masked interrupt status</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <!--DSRMMIS: nUARTDSR modem masked interrupt status-->
            <field>
              <name>DSRMMIS</name>
              <description>nUARTDSR modem masked interrupt status</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
            </field>
            <!--DCDMMIS: nUARTDCD modem masked interrupt status-->
            <field>
              <name>DCDMMIS</name>
              <description>nUARTDCD modem masked interrupt status</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
            </field>
            <!--CTSMMIS: nUARTCTS modem masked interrupt status-->
