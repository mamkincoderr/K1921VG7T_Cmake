              <description>Stop Timer when TX DMA channel ends all transactions</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <!--MODE: Count mode-->
            <field>
              <name>MODE</name>
              <description>Count mode</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Stop</name>
                  <description>Timer is Stopped</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Up</name>
                  <description>Timer count Up</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Multiple</name>
                  <description>Timer count is multiple Up</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>UpDown</name>
                  <description>Timer count is multiple Up - Down</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--CLR: Timer Clear-->
            <field>
              <name>CLR</name>
              <description>Timer Clear</description>
              <bitRange>[2:2]</bitRange>
              <access>write-only</access>
            </field>
            <!--FREESOFT: Emulation mode bits - select the behavior of the time-base counter during emulation events-->
            <field>
              <name>FREESOFT</name>
              <description>Emulation mode bits - select the behavior of the time-base counter during emulation events</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>StopAtCLK</name>
