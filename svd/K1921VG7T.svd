                  <value>11325013</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DUMMY_0</name>
                  <description>Example value that prevents the LOCK bit change</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DUMMY_1</name>
                  <description>Example value that prevents the LOCK bit change</description>
