        <!--TACC0: ADC test access register-->
        <register>
          <name>TACC0</name>
          <description>ADC test access register</description>
          <addressOffset>0x544</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--KEY: Write key 0xFAAC to enter test mode-->
            <field>
              <name>KEY</name>
              <description>Write key 0xFAAC to enter test mode</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TEST_MODE</name>
                  <description>Value that allows to ADC test activities</description>
                  <value>64172</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DUMMY_0</name>
                  <description>Example value that prevents entering to test mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DUMMY_1</name>
                  <description>Example value that prevents entering to test mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--STARTCAL: Generate Start Calculation pulse in test mode-->
