        <offset>0</offset>
        <size>0x1024</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>DMA_CH0</name>
        <description>DMA channel 0 interrupt</description>
        <value>96</value>
      </interrupt>
      <interrupt>
        <name>DMA_CH1</name>
        <description>DMA channel 1 interrupt</description>
        <value>97</value>
      </interrupt>
      <interrupt>
