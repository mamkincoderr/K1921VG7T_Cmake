            </field>
            <!--EN: Enable HSE pins-->
            <field>
              <name>EN</name>
              <description>Enable HSE pins</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--RTC-->
    <peripheral>
      <name>RTC</name>
      <version>1.0</version>
      <description>RTC control registers</description>
      <groupName>RTC</groupName>
      <baseAddress>0x50005000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x60</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>RTC</name>
        <description>RTC interrupt [any cause]</description>
        <value>2</value>
      </interrupt>
      <interrupt>
        <name>RTC_ALARM1</name>
        <description>RTC alarm 1 interrupt</description>
        <value>110</value>
      </interrupt>
      <interrupt>
        <name>RTC_ALARM2</name>
        <description>RTC alarm 2 interrupt</description>
        <value>111</value>
      </interrupt>
      <interrupt>
        <name>RTC_BATTERY</name>
        <description>RTC switch to battery power supply interrupt</description>
        <value>112</value>
      </interrupt>
      <interrupt>
        <name>RTC_N_POWER</name>
        <description>RTC switch to normal power supply interrupt</description>
        <value>113</value>
      </interrupt>
      <interrupt>
        <name>RTC_OVERFLOW</name>
        <description>RTC timer overflow interrupt</description>
        <value>114</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--TIME: Time register-->
        <register>
          <name>TIME</name>
          <description>Time register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: -->
            <field>
              <name>VAL</name>
              <description />
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ALARM1: Alarm 1 register-->
        <register>
          <name>ALARM1</name>
          <description>Alarm 1 register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: -->
            <field>
              <name>VAL</name>
              <description />
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ALARM2: Alarm 2 register-->
        <register>
          <name>ALARM2</name>
          <description>Alarm 2 register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: -->
            <field>
              <name>VAL</name>
              <description />
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CONTROL: Control register-->
        <register>
          <name>CONTROL</name>
          <description>Control register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--FCM: Use 32 kHz clock to time register increment-->
            <field>
              <name>FCM</name>
              <description>Use 32 kHz clock to time register increment</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORMAL_MODE</name>
                  <description>The time register is incremented each second</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>FAST_MODE</name>
                  <description>32 kHz clock is used to increment the time register</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--DRC: Disable RC oscillator-->
            <field>
              <name>DRC</name>
              <description>Disable RC oscillator</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--OIE: Timer overflow interrupt enable-->
            <field>
              <name>OIE</name>
              <description>Timer overflow interrupt enable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--NPIE: Switch to normal power supply interrupt enable-->
            <field>
              <name>NPIE</name>
              <description>Switch to normal power supply interrupt enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--BIE: Switch to battery supply interrupt enable-->
            <field>
              <name>BIE</name>
              <description>Switch to battery supply interrupt enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--A2IE: ALARM2 = TIME interrupt enable-->
            <field>
              <name>A2IE</name>
              <description>ALARM2 = TIME interrupt enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--A1IE: ALARM1 = TIME interrupt enable-->
            <field>
              <name>A1IE</name>
              <description>ALARM1 = TIME interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--STATUS: Status register-->
        <register>
          <name>STATUS</name>
          <description>Status register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--BU: Battery supply is used status-->
            <field>
              <name>BU</name>
              <description>Battery supply is used status</description>
              <bitRange>[31:31]</bitRange>
              <access>read-only</access>
            </field>
            <!--OSC_OK: RC oscillator state is ok-->
            <field>
              <name>OSC_OK</name>
              <description>RC oscillator state is ok</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <!--OF: Timer overflow was detected-->
            <field>
              <name>OF</name>
              <description>Timer overflow was detected</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--NPF: Switch to normal power supply was detected-->
            <field>
              <name>NPF</name>
              <description>Switch to normal power supply was detected</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--BF: Switch to battery supply was detected-->
            <field>
              <name>BF</name>
              <description>Switch to battery supply was detected</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--A2F: ALARM2 = TIME front was detected-->
            <field>
              <name>A2F</name>
              <description>ALARM2 = TIME front was detected</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--A1F: ALARM1 = TIME front was detected-->
            <field>
              <name>A1F</name>
              <description>ALARM1 = TIME front was detected</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--TRIM_RC: RC oscillator trim register-->
        <register>
          <name>TRIM_RC</name>
          <description>RC oscillator trim register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SIGN: -->
            <field>
              <name>SIGN</name>
              <description />
              <bitRange>[7:7]</bitRange>
