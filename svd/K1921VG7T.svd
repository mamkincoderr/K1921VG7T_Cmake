              <description>Receive interrupt FIFO level select</description>
              <bitRange>[27:24]</bitRange>
              <access>read-write</access>
            </field>
            <!--SOD: Disable bit data-->
            <field>
              <name>SOD</name>
              <description>Disable bit data</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
            </field>
            <!--MS: Select mode-->
            <field>
              <name>MS</name>
              <description>Select mode</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MASTER</name>
                  <description>Master mode selected</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SLAVE</name>
                  <description>Slave mode selected</description>
                  <value>1</value>
