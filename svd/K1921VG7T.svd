    <!--DAC-->
    <peripheral>
      <name>DAC</name>
      <version>1.0</version>
      <description>DAC control registers</description>
      <groupName>DAC</groupName>
      <baseAddress>0x50013000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x34</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <!-- -->
        <!--DATA12: Output data register (12 bits)-->
        <register>
          <name>DATA12</name>
          <description>Output data register (12 bits)</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: -->
            <field>
              <name>VAL</name>
              <description />
              <bitRange>[11:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--DATA8: Output data register (8 MSBs)-->
        <register>
          <name>DATA8</name>
          <description>Output data register (8 MSBs)</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Write 8 most significant bits (4 less significant bits will be set to 0)-->
            <field>
              <name>VAL</name>
              <description>Write 8 most significant bits (4 less significant bits will be set to 0)</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CONTROL: Control register-->
        <register>
          <name>CONTROL</name>
          <description>Control register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x1</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--OFFSET: Offset for pattern generator-->
            <field>
              <name>OFFSET</name>
              <description>Offset for pattern generator</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <!--NEGATE: Convert data to it's two's complement value-->
            <field>
              <name>NEGATE</name>
              <description>Convert data to it's two's complement value</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
            </field>
            <!--MULDIV: Switch between up and downscale-->
            <field>
              <name>MULDIV</name>
              <description>Switch between up and downscale</description>
              <bitRange>[19:19]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DOWNSCALE</name>
                  <description>division (shift SCALE positions to the right)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>UPSCALE</name>
                  <description>multiplication (shift SCALE positions to the left)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--SCALE: Scale value for up/downscale input data in steps by power of 2-->
            <field>
              <name>SCALE</name>
              <description>Scale value for up/downscale input data in steps by power of 2</description>
              <bitRange>[18:16]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOSHIFT</name>
                  <description>multiplication/division by 1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHIFT1</name>
                  <description>multiplication/division by 2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHIFT2</name>
                  <description>multiplication/division by 4</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHIFT3</name>
                  <description>multiplication/division by 8</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHIFT4</name>
                  <description>multiplication/division by 16</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHIFT5</name>
                  <description>multiplication/division by 32</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHIFT6</name>
                  <description>multiplication/division by 64</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHIFT7</name>
                  <description>multiplication/division by 128</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--MASK: DAC channel mask/amplitude selector-->
            <field>
              <name>MASK</name>
              <description>DAC channel mask/amplitude selector</description>
              <bitRange>[15:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--SIGN: Signed DAC mode enable-->
            <field>
              <name>SIGN</name>
              <description>Signed DAC mode enable</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UNSIGNED</name>
                  <description>Data treated as unsigned value</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SIGNED</name>
                  <description>Data treated as signed values</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--DATAMODE: [unused] Switch between independent and simultaneous DAC mode-->
            <field>
              <name>DATAMODE</name>
              <description>[unused] Switch between independent and simultaneous DAC mode</description>
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
              <usage>read</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INDEPENDENT</name>
                  <description>Independent DAC mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SIMULTANEOUS</name>
                  <description>Simultaneous DAC mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--WAVE: DAC channel wave generation enable-->
            <field>
              <name>WAVE</name>
              <description>DAC channel wave generation enable</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NONE</name>
                  <description>Wave generation disabled</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NOISE</name>
                  <description>Noise wave generation enable</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRIANGULAR</name>
                  <description>Triangular wave generation enable</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PATTERN</name>
                  <description>Pattern generator enable</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--TSEL: Select DAC trigger event-->
            <field>
              <name>TSEL</name>
              <description>Select DAC trigger event</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SWTRIG</name>
                  <description>software request by SWTRIG bit</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HWTRIG</name>
                  <description>hardware request from internal trigger generator</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GPIOA</name>
                  <description>GPIO A interrupt</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>GPIOB</name>
                  <description>GPIO B interrupt</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR32_0</name>
                  <description>Timer 0 (TMR32_0) request</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR32_1</name>
                  <description>Timer 1 (TMR32_1) request</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR16_0</name>
                  <description>Timer 2 (TMR16_0) request</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR16_1</name>
                  <description>Timer 3 (TMR16_1) request</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TMR16_2</name>
                  <description>Timer 4 (TMR16_2) request</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DUMMY_9</name>
                  <description>Reserved</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DUMMY_10</name>
                  <description>Reserved</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DUMMY_11</name>
                  <description>Reserved</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DUMMY_12</name>
                  <description>Reserved</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DUMMY_13</name>
                  <description>Reserved</description>
                  <value>13</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DUMMY_14</name>
                  <description>Reserved</description>
                  <value>14</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DUMMY_15</name>
                  <description>Reserved</description>
                  <value>15</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--SHUNT: Enable shunt resistor (explore)-->
            <field>
              <name>SHUNT</name>
              <description>Enable shunt resistor (explore)</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--BUF_EN: Enable output buffer-->
            <field>
              <name>BUF_EN</name>
              <description>Enable output buffer</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--EXT_REF: Use external reference voltage source-->
            <field>
              <name>EXT_REF</name>
              <description>Use external reference voltage source</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INTERNAL_REF</name>
                  <description>Use internal reference volatage source</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXTERNAL_REF</name>
                  <description>Use external 3.3 V reference volatage source</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--DISABLE: Disable DAC block-->
            <field>
              <name>DISABLE</name>
              <description>Disable DAC block</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--BGCTRL: Internal reference-voltage source (adjustable BandGap) register-->
        <register>
          <name>BGCTRL</name>
          <description>Internal reference-voltage source (adjustable BandGap) register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x800</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
