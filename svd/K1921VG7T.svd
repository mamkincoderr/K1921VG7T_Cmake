              <description>Software trigger</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--HWTRIG: Internal Hardware trigger generator control register-->
        <register>
          <name>HWTRIG</name>
