    <!--FLASH-->
    <peripheral>
      <name>FLASH</name>
      <version>1.0</version>
      <description>Flash status and control module</description>
      <groupName>FLASH</groupName>
      <baseAddress>0x50002000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x1a0</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>FLASH</name>
        <description>Flash interrupt</description>
        <value>108</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--ADDR: Address Register-->
        <register>
          <name>ADDR</name>
          <description>Address Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--ADDRESS: Access address (ADDRESS[2:0] value is ignored)-->
            <field>
              <name>ADDRESS</name>
              <description>Access address (ADDRESS[2:0] value is ignored)</description>
              <bitRange>[18:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--NVR_ADDR: Address Register for NVR access-->
        <register>
          <name>NVR_ADDR</name>
          <description>Address Register for NVR access</description>
          <alternateRegister>ADDR</alternateRegister>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--HIGH_SECTOR: Sector address value (msb) to selected flash IP-->
            <field>
              <name>HIGH_SECTOR</name>
              <description>Sector address value (msb) to selected flash IP</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
            </field>
            <!--SECTOR_ADDR: Sector address value (lsb) to selected flash IP-->
            <field>
              <name>SECTOR_ADDR</name>
              <description>Sector address value (lsb) to selected flash IP</description>
              <bitRange>[12:10]</bitRange>
              <access>read-write</access>
            </field>
            <!--ADDRESS: Address value within current sector (ADDRESS[2:0] value is ignored)-->
            <field>
              <name>ADDRESS</name>
              <description>Address value within current sector (ADDRESS[2:0] value is ignored)</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--DATA: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-1</dimIndex>
          <!--end of dimElementGroup-->
          <name>DATA[%s]</name>
          <description>DATA</description>
          <addressOffset>0x10</addressOffset>
          <register>
            <name />
            <description>Data Register</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <access>read-write</access>
            <resetValue>0xffffffff</resetValue>
            <resetMask>0xFFFFFFFF</resetMask>
            <fields>
              <!--VAL: Data register value for flash operations-->
              <field>
                <name>VAL</name>
                <description>Data register value for flash operations</description>
                <bitRange>[31:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
        </cluster>
        <!--CMD: Command Register-->
        <register>
          <name>CMD</name>
          <description>Command Register</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xc0de0000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--KEY: Magic Key for flash access "C0DE"-->
            <field>
              <name>KEY</name>
              <description>Magic Key for flash access "C0DE"</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Access</name>
                  <description>magic Key for flash access</description>
                  <value>49374</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--NVRON: NVR access bit-->
            <field>
              <name>NVRON</name>
              <description>NVR access bit</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--DPD: Enter/Exit power down mode-->
            <field>
              <name>DPD</name>
              <description>Enter/Exit power down mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--ALLSEC: Select all sectors for erase-->
            <field>
              <name>ALLSEC</name>
              <description>Select all sectors for erase</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--ERSEC: Erase sector enable command-->
            <field>
              <name>ERSEC</name>
              <description>Erase sector enable command</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--WR: Write enable command-->
            <field>
              <name>WR</name>
              <description>Write enable command</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--RD: Read enable command-->
            <field>
              <name>RD</name>
              <description>Read enable command</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--STAT: Status Register-->
        <register>
          <name>STAT</name>
          <description>Status Register</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--NVRLOCK: If set NVR_CFG sector of flash is locked-->
            <field>
              <name>NVRLOCK</name>
              <description>If set NVR_CFG sector of flash is locked</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
            </field>
            <!--DPD: Flash IP in powerdown mode-->
            <field>
              <name>DPD</name>
              <description>Flash IP in powerdown mode</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
            <!--IRQF: IRQ Flag set when command done. Set by hardware only if IRQEN bit is set.-->
            <field>
              <name>IRQF</name>
              <description>IRQ Flag set when command done. Set by hardware only if IRQEN bit is set.</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--BUSY: Busy status bit when command is processing-->
            <field>
              <name>BUSY</name>
              <description>Busy status bit when command is processing</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--CTRL: Control Register-->
        <register>
          <name>CTRL</name>
          <description>Control Register</description>
          <addressOffset>0x48</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--LAT: Flash latency-->
            <field>
              <name>LAT</name>
              <description>Flash latency</description>
              <bitRange>[19:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--FBFLUSH: Flush internal buffer-->
            <field>
              <name>FBFLUSH</name>
              <description>Flush internal buffer</description>
              <bitRange>[8:8]</bitRange>
              <access>write-only</access>
            </field>
            <!--IRQEN: Interrupt enable bit-->
            <field>
              <name>IRQEN</name>
              <description>Interrupt enable bit</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--FBEN: Fetch buffer Enable-->
            <field>
              <name>FBEN</name>
              <description>Fetch buffer Enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCETR: Flash Timing Control register (Erase time)-->
        <register>
          <name>FTCETR</name>
          <description>Flash Timing Control register (Erase time)</description>
          <addressOffset>0x100</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xea60</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TSCE: Erase time value in cycles-->
            <field>
              <name>TSCE</name>
              <description>Erase time value in cycles</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCPRT: Flash Timing Control register (Program time)-->
        <register>
          <name>FTCPRT</name>
          <description>Flash Timing Control register (Program time)</description>
          <addressOffset>0x104</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x48201030</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TPROG: Program time value in cycles-->
            <field>
              <name>TPROG</name>
              <description>Program time value in cycles</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <!--TPREPGS: PREPG to PROG2 time value in cycles-->
            <field>
              <name>TPREPGS</name>
              <description>PREPG to PROG2 time value in cycles</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--TPREPROG: Pre-program time value in cycles-->
            <field>
              <name>TPREPROG</name>
              <description>Pre-program time value in cycles</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--TPGS: Web to PROG2 high time value in cycles-->
            <field>
              <name>TPGS</name>
              <description>Web to PROG2 high time value in cycles</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCERTR: Flash Timing Control register (Erase Recovery time)-->
        <register>
          <name>FTCERTR</name>
          <description>Flash Timing Control register (Erase Recovery time)</description>
          <addressOffset>0x108</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x32000c8</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TRCVCHIP: Chip erase recovery time value in cycles-->
            <field>
              <name>TRCVCHIP</name>
              <description>Chip erase recovery time value in cycles</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--TRCVSECT: Sector erase recovery time value in cycles-->
            <field>
              <name>TRCVSECT</name>
              <description>Sector erase recovery time value in cycles</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--FTCPRTR: Flash Timing Control register (Program Recovery time)-->
        <register>
          <name>FTCPRTR</name>
          <description>Flash Timing Control register (Program Recovery time)</description>
          <addressOffset>0x10c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x14</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TRCVPROG: Program recovery time value in cycles-->
            <field>
              <name>TRCVPROG</name>
              <description>Program recovery time value in cycles</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--Reserved: Flash ECC Double Error Address register-->
        <register>
          <name>Reserved</name>
          <description>Flash ECC Double Error Address register</description>
          <addressOffset>0x19c</addressOffset>
          <size>0</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Last latched address when double error occurred-->
            <field>
              <name>VAL</name>
              <description>Last latched address when double error occurred</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--SIU-->
    <peripheral>
      <name>SIU</name>
      <version>1.0</version>
      <description>System interconnect unit</description>
      <groupName>SIU</groupName>
      <baseAddress>0x50003000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x74</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <!-- -->
        <!--CHIPID: Chip identifier-->
        <register>
          <name>CHIPID</name>
          <description>Chip identifier</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x4e4c402</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--ID: Model ID-->
            <field>
              <name>ID</name>
              <description>Model ID</description>
              <bitRange>[31:4]</bitRange>
              <access>read-only</access>
            </field>
            <!--REV: Revision number-->
            <field>
              <name>REV</name>
              <description>Revision number</description>
              <bitRange>[3:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--SERVCTL: Service mode Register-->
        <register>
          <name>SERVCTL</name>
          <description>Service mode Register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--SERVCMD: Service mode erase comand/status-->
            <field>
              <name>SERVCMD</name>
              <description>Service mode erase comand/status</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--SERVSTAT: Service mode status-->
            <field>
              <name>SERVSTAT</name>
              <description>Service mode status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--TMRCFG: Timers external clock config-->
        <register>
          <name>TMRCFG</name>
          <description>Timers external clock config</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TMR4CLKMUX: Select external clock source TMR16_2-->
            <field>
              <name>TMR4CLKMUX</name>
              <description>Select external clock source TMR16_2</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EXTPIN</name>
                  <description>external controler pin</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRETIMER</name>
                  <description>previous timer PWM-output</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--TMR3CLKMUX: Select external clock source TMR16_1-->
            <field>
              <name>TMR3CLKMUX</name>
              <description>Select external clock source TMR16_1</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EXTPIN</name>
                  <description>external controler pin</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRETIMER</name>
                  <description>previous timer PWM-output</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--TMR2CLKMUX: Select external clock source TMR16_1-->
            <field>
              <name>TMR2CLKMUX</name>
              <description>Select external clock source TMR16_1</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EXTPIN</name>
                  <description>external controler pin</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRETIMER</name>
                  <description>previous timer PWM-output</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--TMR1CLKMUX: Select external clock source TMR32_1-->
            <field>
              <name>TMR1CLKMUX</name>
              <description>Select external clock source TMR32_1</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EXTPIN</name>
                  <description>external controler pin</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRETIMER</name>
                  <description>previous timer PWM-output</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--TMR0CLKMUX: Select external clock source TMR32_0-->
            <field>
              <name>TMR0CLKMUX</name>
              <description>Select external clock source TMR32_0</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <usage>read-write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>EXTPIN</name>
                  <description>external controler pin</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PRETIMER</name>
                  <description>previous timer PWM-output</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <!--TMREN: Timers counting enable register-->
        <register>
          <name>TMREN</name>
          <description>Timers counting enable register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CNT4EN: TMR16_2 counting enable-->
            <field>
              <name>CNT4EN</name>
              <description>TMR16_2 counting enable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--CNT3EN: TMR16_1 counting enable-->
            <field>
              <name>CNT3EN</name>
              <description>TMR16_1 counting enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <!--CNT2EN: TMR16_0 counting enable-->
            <field>
              <name>CNT2EN</name>
              <description>TMR16_0 counting enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <!--CNT1EN: TMR32_1 counting enable-->
            <field>
              <name>CNT1EN</name>
              <description>TMR32_1 counting enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--CNT0EN: TMR32_0 counting enable-->
            <field>
              <name>CNT0EN</name>
              <description>TMR32_0 counting enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--RAMCTRL: SRAM control register-->
        <register>
          <name>RAMCTRL</name>
          <description>SRAM control register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x4</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--LS1: Ligth Sleep RAM part 1 (16k..32k)-->
            <field>
              <name>LS1</name>
              <description>Ligth Sleep RAM part 1 (16k..32k)</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <!--LS0: Ligth Sleep RAM part 0 (0..16k)-->
            <field>
              <name>LS0</name>
              <description>Ligth Sleep RAM part 0 (0..16k)</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--RM: Read-Write Margin value-->
            <field>
              <name>RM</name>
              <description>Read-Write Margin value</description>
              <bitRange>[2:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--RMEN: Enable to use Read-Write Margin-->
            <field>
              <name>RMEN</name>
              <description>Enable to use Read-Write Margin</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--TCMCTRL: Core Tightly-Coupled Memory SRAM control-->
        <register>
          <name>TCMCTRL</name>
          <description>Core Tightly-Coupled Memory SRAM control</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x4</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--LS3: Ligth Sleep TCM RAM part 3 (24k..32k)-->
            <field>
              <name>LS3</name>
              <description>Ligth Sleep TCM RAM part 3 (24k..32k)</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
            </field>
            <!--LS2: Ligth Sleep TCM RAM part 2 (16..24k)-->
            <field>
              <name>LS2</name>
              <description>Ligth Sleep TCM RAM part 2 (16..24k)</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
            <!--LS1: Ligth Sleep TCM RAM part 1 (8k..16k)-->
            <field>
              <name>LS1</name>
              <description>Ligth Sleep TCM RAM part 1 (8k..16k)</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <!--LS0: Ligth Sleep TCM RAM part 0 (0..8k)-->
            <field>
              <name>LS0</name>
              <description>Ligth Sleep TCM RAM part 0 (0..8k)</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--RM: Read-Write Margin value-->
            <field>
              <name>RM</name>
              <description>Read-Write Margin value</description>
              <bitRange>[2:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--RMEN: Enable to use Read-Write Margin-->
            <field>
              <name>RMEN</name>
              <description>Enable to use Read-Write Margin</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--CRAMCTRL: Core Cache SRAM control-->
        <register>
          <name>CRAMCTRL</name>
          <description>Core Cache SRAM control</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x4</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--L1DLS: Ligth Sleep L1 Data cache RAM-->
            <field>
              <name>L1DLS</name>
              <description>Ligth Sleep L1 Data cache RAM</description>
              <bitRange>[9:9]</bitRange>
              <access>read-write</access>
            </field>
            <!--L1ILS: Ligth Sleep L1 Instruction cache RAM-->
            <field>
              <name>L1ILS</name>
              <description>Ligth Sleep L1 Instruction cache RAM</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--RM: Read-Write Margin value-->
            <field>
              <name>RM</name>
              <description>Read-Write Margin value</description>
              <bitRange>[2:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--RMEN: Enable to use Read-Write Margin-->
            <field>
              <name>RMEN</name>
              <description>Enable to use Read-Write Margin</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--ADCCTRL: ADC level shifters and DP SRAM control-->
        <register>
          <name>ADCCTRL</name>
          <description>ADC level shifters and DP SRAM control</description>
          <addressOffset>0x1c</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x44</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--LSHDIS: Disable Level-Shifters of ADC-->
            <field>
              <name>LSHDIS</name>
              <description>Disable Level-Shifters of ADC</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--LS: Ligth Sleep ADC Dual Port RAM-->
            <field>
              <name>LS</name>
              <description>Ligth Sleep ADC Dual Port RAM</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
            </field>
            <!--RMB: Read-Write Margin value (Port B)-->
            <field>
              <name>RMB</name>
              <description>Read-Write Margin value (Port B)</description>
              <bitRange>[6:5]</bitRange>
              <access>read-write</access>
            </field>
            <!--RMENB: Enable to use Read-Write Margin (Port B)-->
            <field>
              <name>RMENB</name>
              <description>Enable to use Read-Write Margin (Port B)</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--RMA: Read-Write Margin value (Port A)-->
            <field>
              <name>RMA</name>
              <description>Read-Write Margin value (Port A)</description>
              <bitRange>[2:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--RMENA: Enable to use Read-Write Margin (Port A)-->
            <field>
              <name>RMENA</name>
              <description>Enable to use Read-Write Margin (Port A)</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--RCCTRL: RC generator control register-->
        <register>
          <name>RCCTRL</name>
          <description>RC generator control register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x142</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--EN: Internal oscillator enable-->
            <field>
              <name>EN</name>
              <description>Internal oscillator enable</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
