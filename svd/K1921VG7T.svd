              <bitRange>[1:1]</bitRange>
              <access>write-only</access>
            </field>
            <!--RIMIC: nUARTRI modem interrupt clear-->
            <field>
              <name>RIMIC</name>
              <description>nUARTRI modem interrupt clear</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
