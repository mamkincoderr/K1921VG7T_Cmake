              <name>CODE</name>
              <description>Write key 0xACCE55 to change LOCK bit value</description>
              <bitRange>[31:8]</bitRange>
              <access>write-only</access>
              <usage>write</usage>
              <enumeratedValues>
                <enumeratedValue>
