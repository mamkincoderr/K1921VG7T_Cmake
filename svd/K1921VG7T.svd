        <!--BORCFG: Brown-Out Reset Configuration Register-->
        <register>
          <name>BORCFG</name>
          <description>Brown-Out Reset Configuration Register</description>
          <addressOffset>0x90</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TUNE: Tune BOR level-->
            <field>
              <name>TUNE</name>
              <description>Tune BOR level</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--EN: Enable BOR-->
            <field>
              <name>EN</name>
              <description>Enable BOR</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--LOCK: Lock configuration register-->
        <register>
          <name>LOCK</name>
          <description>Lock configuration register</description>
          <addressOffset>0x94</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CODE: Write key 0xACCE55 to change LOCK bit value-->
            <field>
              <name>CODE</name>
              <description>Write key 0xACCE55 to change LOCK bit value</description>
              <bitRange>[31:8]</bitRange>
              <access>write-only</access>
              <usage>write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CHANGE</name>
                  <description>Value that allows the LOCK bit to be changed</description>
                  <value>11325013</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DUMMY_0</name>
                  <description>Example value that prevents the LOCK bit change</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DUMMY_1</name>
                  <description>Example value that prevents the LOCK bit change</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <!--LOCK: Write with specific code to lock / unlock writing to other RCU registers-->
            <field>
              <name>LOCK</name>
              <description>Write with specific code to lock / unlock writing to other RCU registers</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--HSECFG: HSE Configuration Register-->
        <register>
          <name>HSECFG</name>
          <description>HSE Configuration Register</description>
          <addressOffset>0x98</addressOffset>
