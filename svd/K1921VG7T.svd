    <!--WDT-->
    <peripheral>
      <name>WDT</name>
      <version>1.0</version>
      <description>Watchdog timer</description>
      <groupName>WDT</groupName>
      <baseAddress>0x50006000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x320</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>WDT</name>
        <description>Watchdog timer interrupt</description>
        <value>1</value>
      </interrupt>
      <registers>
        <!-- -->
        <!--LOAD: Watchdog Load Register-->
        <register>
          <name>LOAD</name>
          <description>Watchdog Load Register</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0xffffffff</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Begin value counter-->
            <field>
              <name>VAL</name>
              <description>Begin value counter</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--VALUE: Watchdog Value Register-->
        <register>
          <name>VALUE</name>
          <description>Watchdog Value Register</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0xffffffff</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--VAL: Current value counter-->
            <field>
              <name>VAL</name>
              <description>Current value counter</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--CTRL: Watchdog Control Register-->
        <register>
          <name>CTRL</name>
          <description>Watchdog Control Register</description>
          <addressOffset>0x8</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--RESEN: Enable watchdog reset output-->
            <field>
              <name>RESEN</name>
              <description>Enable watchdog reset output</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <!--INTEN: Enable the interrupt event-->
            <field>
              <name>INTEN</name>
              <description>Enable the interrupt event</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--INTCLR: Watchdog Clear Interrupt Register-->
        <register>
          <name>INTCLR</name>
          <description>Watchdog Clear Interrupt Register</description>
          <addressOffset>0xc</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--WDTCLR: Reset interrupt WDT-->
            <field>
              <name>WDTCLR</name>
              <description>Reset interrupt WDT</description>
              <bitRange>[31:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <!--RIS: Watchdog Raw Interrupt Status Register-->
        <register>
          <name>RIS</name>
          <description>Watchdog Raw Interrupt Status Register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--RAWWDTINT: Raw interrupt status from the counter-->
            <field>
              <name>RAWWDTINT</name>
              <description>Raw interrupt status from the counter</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--MIS: Watchdog Interrupt Status Register-->
        <register>
          <name>MIS</name>
          <description>Watchdog Interrupt Status Register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--WDTINT: Enabled interrupt status from the counter-->
            <field>
              <name>WDTINT</name>
              <description>Enabled interrupt status from the counter</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--LOCK: Watchdog Lock Register (write)-->
        <register>
          <name>LOCK</name>
          <description>Watchdog Lock Register (write)</description>
          <addressOffset>0xc00</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--CODE: Enable write access to all other registers by writing LOCK = 0x1ACCE551. Disable write to any othr registers of Watchdog by writing any other value-->
            <field>
              <name>CODE</name>
              <description>Enable write access to all other registers by writing LOCK = 0x1ACCE551. Disable write to any othr registers of Watchdog by writing any other value</description>
              <bitRange>[31:0]</bitRange>
              <access>write-only</access>
              <usage>write</usage>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UNLOCK</name>
                  <description>Value that clear LOCKSTAT.REGWRDIS bit</description>
                  <value>449635665</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOCK_0</name>
                  <description>Example value that set LOCKSTAT.REGWRDIS (write to all registers except LOCK is disabled)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LOCK_1</name>
                  <description>Example value that set LOCKSTAT.REGWRDIS (write to all registers except LOCK is disabled)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <!--LOCKSTAT: Watchdog Lock Register (read)-->
        <register>
          <name>LOCKSTAT</name>
          <description>Watchdog Lock Register (read)</description>
          <alternateRegister>LOCK</alternateRegister>
          <addressOffset>0xc00</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--REGWRDIS: Write to all registers of Watchdog is disabled-->
            <field>
              <name>REGWRDIS</name>
              <description>Write to all registers of Watchdog is disabled</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!--Reserved: Watchdog Integration Test Output Set Register-->
        <register>
          <name>Reserved</name>
          <description>Watchdog Integration Test Output Set Register</description>
          <addressOffset>0xf04</addressOffset>
          <size>0</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--INTOUT_STATE: Bit output state WDTINT-->
            <field>
              <name>INTOUT_STATE</name>
              <description>Bit output state WDTINT</description>
              <bitRange>[1:1]</bitRange>
              <access>write-only</access>
            </field>
            <!--RESOUT_STATE: Bit output state WDTRES-->
            <field>
              <name>RESOUT_STATE</name>
              <description>Bit output state WDTRES</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <!--TMR32_0-->
    <peripheral>
      <name>TMR32_0</name>
      <version>1.0</version>
      <description>Timer 32-bit with PWM control registers</description>
      <groupName>TMR32</groupName>
