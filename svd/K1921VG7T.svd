              <bitRange>[8:8]</bitRange>
              <access>write-only</access>
            </field>
            <!--FEIC: Framing error interrupt clear-->
            <field>
              <name>FEIC</name>
              <description>Framing error interrupt clear</description>
              <bitRange>[7:7]</bitRange>
              <access>write-only</access>
            </field>
            <!--RTIC: Receive timeout interrupt clear-->
            <field>
              <name>RTIC</name>
              <description>Receive timeout interrupt clear</description>
              <bitRange>[6:6]</bitRange>
              <access>write-only</access>
            </field>
            <!--TXIC: Transmit interrupt clear-->
            <field>
              <name>TXIC</name>
              <description>Transmit interrupt clear</description>
              <bitRange>[5:5]</bitRange>
              <access>write-only</access>
            </field>
            <!--RXIC: Receive interrupt clear-->
            <field>
              <name>RXIC</name>
              <description>Receive interrupt clear</description>
              <bitRange>[4:4]</bitRange>
              <access>write-only</access>
            </field>
            <!--DSRMIC: nUARTDSR modem interrupt clear-->
            <field>
              <name>DSRMIC</name>
              <description>nUARTDSR modem interrupt clear</description>
              <bitRange>[3:3]</bitRange>
              <access>write-only</access>
            </field>
            <!--DCDMIC: nUARTDCD modem interrupt clear-->
            <field>
              <name>DCDMIC</name>
