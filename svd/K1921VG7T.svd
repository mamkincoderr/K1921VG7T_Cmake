                    <value>0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SRCCLK</name>
                    <description>HSE(XTALL) if CPE=0 or HSI 4MHz if CPE=1</description>
                    <value>1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SYSPLL0CLK</name>
                    <description>Clock from PLL OUT[0]</description>
                    <value>2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>EXTCLK</name>
                    <description>external CLK from gpio pin</description>
                    <value>3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <!--RSTDIS: Reset disable-->
              <field>
                <name>RSTDIS</name>
                <description>Reset disable</description>
                <bitRange>[4:4]</bitRange>
                <access>read-write</access>
              </field>
              <!--CLKEN: Clock enable-->
              <field>
                <name>CLKEN</name>
                <description>Clock enable</description>
                <bitRange>[0:0]</bitRange>
                <access>read-write</access>
              </field>
            </fields>
          </register>
