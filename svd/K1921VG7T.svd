        </register>
        <!--ICR: Interrupt Clear Register-->
        <register>
          <name>ICR</name>
          <description>Interrupt Clear Register</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--TDIC: Transmit done interrupt clear-->
            <field>
              <name>TDIC</name>
              <description>Transmit done interrupt clear</description>
              <bitRange>[11:11]</bitRange>
              <access>write-only</access>
            </field>
            <!--OEIC: Overrun error interrupt clear-->
            <field>
              <name>OEIC</name>
              <description>Overrun error interrupt clear</description>
              <bitRange>[10:10]</bitRange>
              <access>write-only</access>
            </field>
            <!--BEIC: Break error interrupt clear-->
            <field>
              <name>BEIC</name>
              <description>Break error interrupt clear</description>
              <bitRange>[9:9]</bitRange>
              <access>write-only</access>
            </field>
