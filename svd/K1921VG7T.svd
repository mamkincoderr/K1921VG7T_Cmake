              <bitRange>[11:11]</bitRange>
              <access>read-only</access>
            </field>
            <!--CALSTART: Start ADC internal calibration-->
            <field>
              <name>CALSTART</name>
              <description>Start ADC internal calibration</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
            </field>
