        <description>DMA channel 2 interrupt</description>
        <value>98</value>
      </interrupt>
      <interrupt>
        <name>DMA_CH3</name>
        <description>DMA channel 3 interrupt</description>
        <value>99</value>
      </interrupt>
      <interrupt>
        <name>DMA_CH4</name>
        <description>DMA channel 4 interrupt</description>
        <value>100</value>
      </interrupt>
      <interrupt>
        <name>DMA_CH5</name>
        <description>DMA channel 5 interrupt</description>
        <value>101</value>
      </interrupt>
      <interrupt>
