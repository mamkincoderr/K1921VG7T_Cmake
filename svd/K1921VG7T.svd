              <access>read-only</access>
            </field>
            <!--OEMIS: Overrun error masked interrupt status-->
            <field>
              <name>OEMIS</name>
              <description>Overrun error masked interrupt status</description>
              <bitRange>[10:10]</bitRange>
              <access>read-only</access>
            </field>
            <!--BEMIS: Break error masked interrupt status-->
            <field>
              <name>BEMIS</name>
