              <access>write-only</access>
            </field>
            <!--SOC: Generate Start Of Conversion pulse in test mode-->
            <field>
              <name>SOC</name>
              <description>Generate Start Of Conversion pulse in test mode</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
