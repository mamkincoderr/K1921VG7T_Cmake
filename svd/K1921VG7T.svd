            </field>
            <!--VAL: -->
            <field>
              <name>VAL</name>
              <description />
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--GPR: -->
        <cluster>
          <!--dimElementGroup-->
          <dim>16</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>0-15</dimIndex>
          <!--end of dimElementGroup-->
          <name>GPR[%s]</name>
