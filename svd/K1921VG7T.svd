        <!--PLLDIV: PLL DIV Configuration Register-->
        <register>
          <name>PLLDIV</name>
          <description>PLL DIV Configuration Register</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x32000014</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <!--NDIV: Integer part of divider (divide pre-divisor result by NDIV)-->
            <field>
              <name>NDIV</name>
              <description>Integer part of divider (divide pre-divisor result by NDIV)</description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
            <!--RDIV: R-divider coefficient (divide Fin by (RDIV + 1))-->
            <field>
              <name>RDIV</name>
              <description>R-divider coefficient (divide Fin by (RDIV + 1))</description>
              <bitRange>[21:16]</bitRange>
              <access>read-write</access>
            </field>
            <!--RNCLR: R-divider enable-->
            <field>
              <name>RNCLR</name>
              <description>R-divider enable</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
            </field>
            <!--NNCLR: N-divider enable-->
            <field>
              <name>NNCLR</name>
              <description>N-divider enable</description>
              <bitRange>[14:14]</bitRange>
              <access>read-write</access>
            </field>
            <!--PREDIV: Pre-divisor coefficient. PREDIV = 0 | 1 | 2 | 3 -> divide Fvco by 1 | 1 | 2 | 3-->
            <field>
              <name>PREDIV</name>
              <description>Pre-divisor coefficient. PREDIV = 0 | 1 | 2 | 3 -&gt; divide Fvco by 1 | 1 | 2 | 3</description>
              <bitRange>[13:12]</bitRange>
              <access>read-write</access>
            </field>
            <!--DIV1B: Divider 1B (divide divider 1A result by (DIV1B + 1))-->
            <field>
              <name>DIV1B</name>
              <description>Divider 1B (divide divider 1A result by (DIV1B + 1))</description>
              <bitRange>[9:4]</bitRange>
              <access>read-write</access>
            </field>
            <!--DIV1A: Divider 1A (divide pre-divisor result by (DIV1A + 1))-->
            <field>
              <name>DIV1A</name>
              <description>Divider 1A (divide pre-divisor result by (DIV1A + 1))</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!--PLLFRAC: PLL FRAC Configuration Register-->
